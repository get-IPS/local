  border-radius:50%;
  border:2.5px solid #ff7a18;
  opacity:0;
  box-shadow:
    0 0 34px rgba(255,122,24,.65),
    inset 0 0 20px rgba(216,221,226,.35);
  animation:waveOut 1.2s cubic-bezier(.12,.6,.24,1) forwards
}

.rv-wave.w2{
