/* ===== PANGGUNG ===== */
.stage{
  position:relative;
  z-index:1;
  width:100%;
  min-height:100vh;
  display:flex;
  flex-direction:column;
  align-items:center;
  justify-content:center;
  padding:22px 16px 34px
}

.brand-panel{display:none}

.link-panel{
  width:100%;
  max-width:420px;
  display:flex;
  flex-direction:column;
  align-items:center;
  gap:13px
}

.logo-wrapper{
  text-align:center;
  padding-top:2px;
  animation:
    fadeDown 1.3s cubic-bezier(.16,1,.3,1)
    2.2s both
}

.logo-wrapper amp-img{
  filter:
    drop-shadow(0 0 10px rgba(255,122,24,.45))
    drop-shadow(0 0 18px rgba(216,221,226,.22))
}

/* ===== MARQUEE ===== */
.marquee-wrapper{
  width:100%;
  overflow:hidden;
  padding:4px 0;
  border-radius:8px;
  box-shadow:
    0 0 16px rgba(255,122,24,.35);
  animation:
    borderFlow 7s linear infinite,
    fadeDown 1.3s cubic-bezier(.16,1,.3,1)
    2.3s both
}

.marquee-track{
  display:flex;
  width:max-content;
  animation:marquee 18s linear infinite
}

.marquee-track span{
  color:#eef1f4;
  font-size:12.5px;
  font-weight:700;
  letter-spacing:.5px;
  padding:0 18px;
  white-space:nowrap;
  text-shadow:
    0 0 8px rgba(255,122,24,.45)
}

@keyframes marquee{
  from{transform:translateX(0)}
  to{transform:translateX(-50%)}
}

/* ===== CARD ===== */
.card{
  width:100%;
  padding:11px;
  display:flex;
  flex-direction:column;
  gap:12px;
  align-items:center;
  border:1.5px solid transparent;
  border-radius:22px;
  background:
    linear-gradient(
      180deg,
      var(--card-fill-1),
      var(--card-fill-2)
    ) padding-box,
    linear-gradient(
      120deg,
      #292c30,
      #ff7a18 22%,
      #eef1f4 42%,
      #8f959c 50%,
      #eef1f4 58%,
      #ff7a18 78%,
      #292c30
    ) border-box;
  background-size:100% 100%,320% 100%;
  box-shadow:
    0 24px 60px rgba(0,0,0,.65),
    0 0 20px rgba(255,122,24,.18);
  animation:
    scaleIn 1.3s cubic-bezier(.16,1,.3,1) 2.4s both,
    borderFlow 8s linear infinite,
    cardGlow 6s 4s infinite alternate
}

@keyframes cardGlow{
  from{
    box-shadow:
      0 24px 60px rgba(0,0,0,.65),
      0 0 16px rgba(255,122,24,.12)
  }
  to{
    box-shadow:
      0 24px 70px rgba(0,0,0,.7),
      0 0 42px rgba(255,122,24,.32),
      0 0 18px rgba(216,221,226,.12)
  }
}

/* ===== HERO ===== */
.hero{
  width:100%;
  border-radius:16px;
  overflow:hidden;
  position:relative;
  border:1px solid rgba(255,122,24,.55)
}

.hero amp-img{
  border-radius:16px
}

.hero::after{
  content:"";
  position:absolute;
  inset:0;
  border-radius:16px;
  pointer-events:none;
  animation:heroSheen 6s linear infinite
}

@keyframes heroSheen{
  0%{
    box-shadow:
      inset 0 0 30px rgba(0,0,0,.5),
      inset 70px 0 70px -50px rgba(255,122,24,.42)
  }
  50%{
    box-shadow:
      inset 0 0 30px rgba(0,0,0,.5),
      inset -70px 0 70px -50px rgba(216,221,226,.38)
  }
  100%{
    box-shadow:
      inset 0 0 30px rgba(0,0,0,.5),
      inset 70px 0 70px -50px rgba(255,122,24,.42)
  }
}

/* ===== LINKS ===== */
.links{
  width:100%;
  display:flex;
  flex-direction:column;
  gap:11px
}

.link-btn{
  position:relative;
  display:flex;
  align-items:center;
  gap:12px;
  width:100%;
  text-decoration:none;
  padding:8px 14px;
  overflow:hidden;
  color:var(--text);
  border:1.5px solid transparent;
  border-radius:14px;
  background:
    linear-gradient(
      180deg,
      rgba(30,32,36,.68),
      rgba(12,13,16,.97)
    ) padding-box,
    linear-gradient(
      120deg,
      #292c30,
      #ff7a18 24%,
      #eef1f4 43%,
      #8f959c 50%,
      #eef1f4 57%,
      #ff7a18 76%,
      #292c30
    ) border-box;
  background-size:100% 100%,300% 100%;
  box-shadow:
    0 8px 20px rgba(0,0,0,.5);
  transition:
    transform .4s cubic-bezier(.16,1,.3,1),
    box-shadow .4s cubic-bezier(.16,1,.3,1);
  animation:
    fadeUp 1.2s cubic-bezier(.16,1,.3,1)
    var(--d,2.5s) both,
    borderFlow 6s linear infinite
}

.link-btn .ico{
  flex:0 0 42px;
  width:42px;
  height:42px;
  border-radius:12px;
  display:flex;
  align-items:center;
  justify-content:center;
  background:rgba(255,122,24,.10);
  border:1px solid var(--line);
  transition:
    transform .4s cubic-bezier(.16,1,.3,1)
}

.link-btn .ico svg{
  width:20px;
  height:20px;
  stroke:#ff9a3d;
  fill:none;
  stroke-width:2;
  stroke-linecap:round;
  stroke-linejoin:round
}

.link-btn .label{
  flex:1;
  text-align:left;
  font-weight:700;
  font-size:14.5px;
  letter-spacing:.4px;
  line-height:1.15
}

.link-btn .label small{
  display:block;
  font-weight:500;
  font-size:11px;
  color:var(--muted);
  letter-spacing:.2px;
  margin-top:2px
}

.link-btn .arrow{
  flex:0 0 auto;
  color:#ff9a3d;
  opacity:.85;
  transition:
    transform .4s cubic-bezier(.16,1,.3,1)
}

.link-btn .arrow svg{
  width:16px;
  height:16px;
  stroke:currentColor;
  fill:none;
  stroke-width:2.6;
  stroke-linecap:round;
  stroke-linejoin:round
}

/* ===== BUTTON SHINE ===== */
.link-btn::before{
  content:"";
  position:absolute;
  top:0;
  left:-130%;
  width:55%;
  height:100%;
  transform:skewX(-22deg);
  background:
    linear-gradient(
      90deg,
      transparent,
      rgba(255,122,24,.65),
      rgba(238,241,244,.35),
      transparent
    );
  animation:shineSweep 6s infinite
}

@keyframes shineSweep{
  0%{left:-130%}
  20%{left:230%}
  100%{left:230%}
}

.link-btn:hover{
  transform:translateY(-4px);
  box-shadow:
    0 12px 26px rgba(0,0,0,.7),
    0 0 22px rgba(255,122,24,.28)
}

.link-btn:hover .ico{
  transform:scale(1.1) rotate(-4deg)
}

.link-btn:hover .arrow{
  transform:translateX(6px)
}

/* ===== PRIMARY BUTTON ===== */
.link-btn.primary{
  background:
    linear-gradient(
      120deg,
      #ffb15f,
      #ff7a18 42%,
      #e45c00 70%,
      #c94f00
    );
  color:#111214;
  box-shadow:
    0 10px 26px rgba(255,122,24,.38);
  animation:
    fadeUp 1.2s cubic-bezier(.16,1,.3,1)
    var(--d,2.5s) both,
    primaryGlow 4s ease-in-out infinite
}

.link-btn.primary .label,
.link-btn.primary .arrow{
  color:#111214
}

.link-btn.primary .label small{
  color:rgba(20,22,25,.72)
}

.link-btn.primary .ico{
  background:rgba(0,0,0,.10);
  border-color:rgba(0,0,0,.18)
}

.link-btn.primary .ico svg{
  stroke:#111214
}

.link-btn.primary::before{
  background:
    linear-gradient(
      90deg,
      transparent,
      rgba(255,255,255,.9),
      rgba(255,255,255,.35),
      transparent
    )
}

@keyframes primaryGlow{
  0%,100%{
    box-shadow:
      0 10px 26px rgba(255,122,24,.35)
  }
  50%{
    box-shadow:
      0 12px 34px rgba(255,122,24,.58),
      0 0 18px rgba(255,154,61,.25)
  }
}

.link-btn:nth-child(1){--d:2.55s}
.link-btn:nth-child(2){--d:2.70s}
.link-btn:nth-child(3){--d:2.85s}

/* ===== FOOTER ===== */
.footer{
  text-align:center;
  color:var(--muted);
  font-size:11px;
  line-height:1.7;
  margin-top:0;
  animation:
    fadeUp 1.2s cubic-bezier(.16,1,.3,1)
    3.1s both
}

.footer b{
  color:#ff9a3d;
  text-shadow:
    0 0 10px rgba(255,122,24,.55)
}

.socials{
  display:flex;
  gap:10px;
  justify-content:center;
  margin-bottom:25px
}

.socials a{
  width:36px;
  height:36px;
  border-radius:11px;
  display:flex;
  align-items:center;
  justify-content:center;
  border:1px solid var(--line);
  background:var(--glass);
  transition:.3s cubic-bezier(.16,1,.3,1)
}

.socials a svg{
  width:16px;
  height:16px;
  stroke:#ff9a3d;
  fill:none;
  stroke-width:2;
  stroke-linecap:round;
  stroke-linejoin:round
}

.socials a:hover{
  background:#ff7a18;
  border-color:#ff7a18;
  transform:translateY(-3px);
  box-shadow:
    0 0 22px rgba(255,122,24,.55)
}

.socials a:hover svg{
  stroke:#15171a
}

/* ===== ANIMATIONS ===== */
@keyframes fadeUp{
  from{
    opacity:0;
    transform:translateY(30px);
    filter:blur(5px)
  }
  to{
    opacity:1;
    transform:translateY(0);
    filter:blur(0)
  }
}

@keyframes fadeDown{
  from{
    opacity:0;
    transform:translateY(-30px);
    filter:blur(5px)
  }
  to{
    opacity:1;
    transform:translateY(0);
    filter:blur(0)
  }
}

@keyframes scaleIn{
  from{
    opacity:0;
    transform:scale(.85);
    filter:blur(6px)
  }
  to{
    opacity:1;
    transform:scale(1);
    filter:blur(0)
  }
}

@keyframes slideRight{
  from{
    opacity:0;
    transform:translateX(-60px);
    filter:blur(5px)
  }
  to{
    opacity:1;
    transform:translateX(0);
    filter:blur(0)
  }
}

@keyframes textShimmer{
  from{background-position:0% center}
  to{background-position:200% center}
}

/* =========================================================
   DESKTOP
========================================================= */
@media (min-width:900px){

  .stage{
    flex-direction:row;
    align-items:center;
    justify-content:center;
    gap:60px;
    max-width:1180px;
    margin:0 auto;
    padding:34px 44px
  }

  .brand-panel{
    position:relative;
    display:flex;
    flex:1;
    max-width:520px;
    flex-direction:column;
    gap:16px;
    animation:
      slideRight 1.3s cubic-bezier(.16,1,.3,1)
      2.3s both
  }

  .brand-panel::before{
    content:"";
    position:absolute;
    z-index:-1;
    left:-60px;
    top:-40px;
    width:360px;
    height:360px;
    border-radius:50%;
    background:
      radial-gradient(
        closest-side,
        rgba(255,122,24,.25),
        rgba(216,221,226,.08),
        transparent 70%
      );
    filter:blur(10px);
    animation:spinGlow 22s linear infinite
  }

  @keyframes spinGlow{
    0%{
      transform:rotate(0) translateX(24px)
    }
    100%{
      transform:rotate(360deg) translateX(24px)
    }
  }

  /* ===== BRAND BADGE ===== */
  .brand-badge{
    display:inline-flex;
    align-items:center;
    gap:9px;
    width:max-content;
    padding:7px 15px;
    border-radius:999px;
    color:#eef1f4;
    font-size:12px;
    font-weight:700;
    letter-spacing:1px;
    box-shadow:
      0 0 18px rgba(255,122,24,.18)
  }

  .brand-badge .dot{
    width:8px;
    height:8px;
    border-radius:50%;
    background:#ff7a18;
    box-shadow:
      0 0 12px rgba(255,122,24,.9);
    animation:pulse 1.6s infinite
  }

  @keyframes pulse{
    0%,100%{
      opacity:1;
      transform:scale(1)
    }
    50%{
      opacity:.35;
      transform:scale(.8)
    }
  }

  /* ===== BRAND TITLE ===== */
  .brand-title{
    font-family:'Sora',sans-serif;
    font-size:44px;
    line-height:1.08;
    font-weight:800;
    margin:0;
    background:
      linear-gradient(
        100deg,
        #ffffff 0%,
        #eef1f4 20%,
        #ff9a3d 38%,
        #ff7a18 50%,
        #d8dde2 65%,
        #ffffff 85%
      );
    background-size:260% auto;
    -webkit-background-clip:text;
    background-clip:text;
    -webkit-text-fill-color:transparent;
    color:transparent;
    filter:
      drop-shadow(0 4px 26px rgba(255,122,24,.28));
    animation:textShimmer 8s linear infinite
  }

  .brand-underline{
    width:130px;
    height:4px;
    border-radius:99px;
    background:
      linear-gradient(
        90deg,
        #292c30,
        #ff7a18 30%,
        #eef1f4 50%,
        #ff7a18 70%,
        #292c30
      );
    background-size:280% 100%;
    animation:borderFlow 5s linear infinite;
    box-shadow:
      0 0 18px rgba(255,122,24,.5)
  }

  .brand-desc{
    color:#c4c8cd;
    font-size:15px;
    line-height:1.7;
    margin:0;
    max-width:450px
  }

  /* ===== CHIPS ===== */
  .chips{
    display:flex;
    flex-wrap:wrap;
    gap:9px
  }

  .chip{
    padding:8px 13px;
    border-radius:999px;
    font-size:11.5px;
    font-weight:600;
    color:#eef1f4;
    letter-spacing:.3px
  }

  .chip svg{
    width:13px;
    height:13px;
    stroke:#ff9a3d;
    fill:none;
    stroke-width:2;
    vertical-align:-2px;
    margin-right:5px
  }

  /* ===== STATS ===== */
  .stats{
    display:flex;
    gap:12px
  }

  .stat{
    flex:1;
    padding:14px 12px;
    border-radius:16px;
    text-align:center;
    box-shadow:
      0 0 18px rgba(255,122,24,.08)
  }

  .stat b{
    display:block;
    font-family:'Sora',sans-serif;
    font-size:22px;
    background:
      linear-gradient(
        120deg,
        #ffffff,
        #d8dde2,
        #ff9a3d,
        #ff7a18,
        #b8bfc6
      );
    background-size:260% auto;
    -webkit-background-clip:text;
    background-clip:text;
    -webkit-text-fill-color:transparent;
    color:transparent;
    animation:textShimmer 6s linear infinite
  }

  .stat span{
    font-size:10.5px;
    color:var(--muted);
    letter-spacing:.6px
  }

  /* ===== TRUST ===== */
  .trust{
    display:flex;
    flex-wrap:wrap;
    gap:10px
  }

  .tbadge{
    display:inline-flex;
    align-items:center;
    gap:7px;
    padding:9px 13px;
    border-radius:12px;
    font-size:11px;
    font-weight:700;
    letter-spacing:.4px;
    color:#eef1f4
  }

  .tbadge svg{
    width:15px;
    height:15px;
    stroke:#ff9a3d;
    fill:none;
    stroke-width:2;
    stroke-linecap:round;
    stroke-linejoin:round
  }

  /* ===== TICKER ===== */
  .ticker{
    height:76px;
    overflow:hidden;
    border-radius:14px;
    padding:6px 4px
  }

  .ticker .roll{
    display:flex;
    flex-direction:column;
    animation:tickerScroll 12s linear infinite
  }

  .ticker .line{
    min-height:32px;
    display:flex;
    align-items:center;
    gap:9px;
    font-size:12px;
    color:#c4c8cd;
    padding:0 12px
  }

  .ticker .line i{
    width:7px;
    height:7px;
    border-radius:50%;
    background:#ff7a18;
    box-shadow:
      0 0 10px rgba(255,122,24,.85);
    flex:0 0 auto
  }

  @keyframes tickerScroll{
    from{transform:translateY(0)}
    to{transform:translateY(-50%)}
  }

  .link-panel{
    flex:0 0 372px;
    max-width:372px;
    gap:12px
  }

  .footer{
    margin-top:12px
  }
}

@media (max-width:899px){
  .brand-panel{
    display:none
  }
}

/* =========================================================
