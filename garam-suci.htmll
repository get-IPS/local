/* ===== INTRO BRAND ===== */
.rv-brand{
  position:absolute;
  display:flex;
  flex-direction:column;
  align-items:center;
  justify-content:center;
  width:100%;
  gap:15px;
  text-align:center
}

.rv-logo{
  animation:logoIn 1s cubic-bezier(.16,1,.3,1) 1.2s both
}

@keyframes logoIn{
  0%{
    opacity:0;
    transform:scale(.7) translateY(15px);
    filter:blur(16px)
  }
  100%{
    opacity:1;
    transform:scale(1) translateY(0);
    filter:blur(0)
  }
}

.rv-line{
  width:0;
  height:2px;
  border-radius:2px;
  background:
    linear-gradient(
      90deg,
      transparent,
      #ff7a18,
      #eef1f4,
      #ff7a18,
      transparent
    );
  box-shadow:0 0 12px rgba(255,122,24,.75);
  animation:
    lineGrow .8s cubic-bezier(.16,1,.3,1)
    1.4s both
}

@keyframes lineGrow{
  0%{
    width:0;
    opacity:0
  }
  100%{
    width:180px;
    opacity:1
  }
}

.rv-tag{
  display:flex;
  justify-content:center;
  align-items:center;
  flex-wrap:wrap;
  width:100%;
  perspective:600px;
  font-family:'Sora',sans-serif;
  font-size:10px;
  font-weight:800;
  letter-spacing:4px;
  padding-left:4px
}

.rv-tag span{
  display:inline-block;
  opacity:0;
  background:
    linear-gradient(
      100deg,
      #ffffff,
      #eef1f4,
      #ff9a3d,
      #ff7a18,
      #d8dde2,
      #ffffff
    );
  background-size:260% auto;
  -webkit-background-clip:text;
  background-clip:text;
  -webkit-text-fill-color:transparent;
  color:transparent;
  animation:
    letterUp .7s cubic-bezier(.16,1,.3,1)
    var(--ld,1.4s) both,
    textShimmer 3s linear infinite
}

.rv-tag .sp{
  width:8px;
  flex:0 0 8px;
  letter-spacing:0
}

@keyframes letterUp{
  0%{
    opacity:0;
    transform:translateY(24px) rotateX(60deg);
    filter:blur(8px)
  }
  100%{
    opacity:1;
    transform:translateY(0) rotateX(0);
    filter:blur(0)
  }
}

.rv-tag span:nth-child(1){--ld:1.4s}
.rv-tag span:nth-child(2){--ld:1.435s}
.rv-tag span:nth-child(3){--ld:1.47s}
.rv-tag span:nth-child(4){--ld:1.505s}
.rv-tag span:nth-child(5){--ld:1.54s}
