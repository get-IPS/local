========================================================= */

body::before{
  content:"";
  position:fixed;
  inset:0;
  z-index:-1;
  pointer-events:none;
  background:
    radial-gradient(
      circle at 12% 18%,
      rgba(255,122,24,.10),
      transparent 26%
    ),
    radial-gradient(
      circle at 88% 28%,
      rgba(216,221,226,.09),
      transparent 25%
    ),
    radial-gradient(
      circle at 50% 100%,
      rgba(255,122,24,.08),
      transparent 34%
    )
}

.card,
.link-btn,
.ticker,
.chip,
.stat,
.tbadge,
.brand-badge{
  backdrop-filter:blur(14px) saturate(105%);
  -webkit-backdrop-filter:blur(14px) saturate(105%)
}

.hero,
.card{
  box-shadow:
    0 24px 65px rgba(0,0,0,.55),
    0 0 26px rgba(255,122,24,.10),
    0 0 10px rgba(216,221,226,.06),
    inset 0 1px 0 rgba(255,255,255,.10)
}

</style>

