@keyframes burst{
  0%{
    transform:translate(0,0) scale(2.5);
    opacity:0
  }
  10%{opacity:1}
  100%{
    transform:
      translate(
        calc(var(--tx) * 1.8),
        calc(var(--ty) * 1.8)
      )
      scale(0);
    opacity:0
  }
